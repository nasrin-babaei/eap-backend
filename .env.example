# Copy this file to .env and change the values. .env is git-ignored.

POSTGRES_USER=eap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eap

# Host "db" is the Postgres service in docker-compose.yml.
# Running the API directly on your machine? Use localhost instead of db.
DATABASE_URL=postgresql://eap:change-me@db:5432/eap

# Signs the JWT login tokens. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
